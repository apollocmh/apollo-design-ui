{
  "$schema": "../schema.json",
  "id": "tree-select/basic",
  "component": "tree-select",
  "description": "BaseSelect 外壳 + 树型 OptionList（内嵌 Tree，恒 checkStrictly）。勾选级联 conductCheck 在本层算；key===value（fillFieldNames）；value 为 key 兼 value 双字段；SHOW_* strategy 展示裁剪；labelInValue / treeCheckStrictly 强制 LabeledValueType（halfChecked）。",
  "antdVersion": "6.6.4",
  "props": {
    "treeData": [
      {
        "title": "parent 1",
        "value": "0-0",
        "children": [
          { "title": "leaf 1", "value": "0-0-0" },
          { "title": "leaf 2", "value": "0-0-1" }
        ]
      },
      { "title": "parent 2", "value": "0-1" }
    ],
    "treeCheckable": true,
    "defaultValue": ["0-0-0"],
    "placeholder": "Please select"
  },
  "assertions": {
    "api": true,
    "dom": true,
    "aria": true,
    "behavior": true,
    "screenshot": true
  },
  "expect": {
    "events": [
      "update:value",
      "update:open",
      "update:searchValue",
      "update:treeExpandedKeys",
      "update:treeLoadedKeys",
      "select",
      "deselect",
      "clear"
    ]
  }
}
