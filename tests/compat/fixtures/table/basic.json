{
  "$schema": "../schema.json",
  "id": "table/basic",
  "component": "table",
  "description": "XL 双层（rc 引擎 + antd 壳）：columns/dataSource/rowKey 渲染、sorter 三态（onChange 载荷含 sorter/currentDataSource）、filters（FilterDropdown Portal + 受控 filteredValue 判据 null）、rowSelection（checkbox/radio/树形 conductCheck/selections 哨兵）、expandable（row/nest/受控 keys）、scroll.x/y（固定列 fix-start/end + FixedHolder 双表）、Summary 行、受控/非受控分页（current 受控、defaultCurrent 非受控）。",
  "antdVersion": "6.6.4",
  "props": {
    "columns": [
      { "title": "Name", "dataIndex": "name", "key": "name" },
      { "title": "Age", "dataIndex": "age", "key": "age" }
    ],
    "dataSource": [
      { "key": "1", "name": "John Brown", "age": 32 },
      { "key": "2", "name": "Jim Green", "age": 42 },
      { "key": "3", "name": "Joe Black", "age": 28 }
    ],
    "rowSelection": { "type": "checkbox" },
    "bordered": true,
    "size": "middle"
  },
  "assertions": {
    "api": true,
    "dom": true,
    "aria": true,
    "behavior": true,
    "screenshot": true
  },
  "expect": {
    "events": ["change", "update:expandedRowKeys", "expand"],
    "dom": {
      "table": true,
      "thead": true,
      "tbody": true,
      "selectionColumn": true
    }
  }
}
