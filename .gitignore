# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
es/
lib/
coverage/
*.tsbuildinfo

# Test outputs
tests/compat/report/
tests/compat/baselines/**/*.diff.png
# L6 visual regression (tests/visual/):
#   - baselines/  is committed (decision visual-baseline-in-git = A)
#   - .artifacts/ / snapshots/ / diff/ / report.html are ephemeral
tests/visual/.artifacts/
tests/visual/snapshots/
tests/visual/diff/
tests/visual/report.html
# shard 摘要（run.mjs 给 assert-shard.mjs 用）与 CI 的 dist 传递包
tests/visual/report.json
tests/visual/report-*.json
build-dist.tar.gz
visualRegressionReport/
playwright-report/
test-results/
.vitest/

# Docs site build
_site/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Local antd reference checkouts (never committed — re-extract with the tool)
# 注意：antd 的参考产物与源码由 registry/tools/extract-antd-facts.mjs 重新获取，
# 不纳入版本控制，避免把别人的代码放进我们的仓库。
antd-reference/
.antd-cache/

# WorkBuddy 本地状态
# .workbuddy 是指向 .workbuddy-ai 的软链接（WorkBuddy 国际版 / 国内版共用同一份记忆）。
# 它只是本机文件系统的便利，不入库；真实记忆仍在 .workbuddy-ai/（继续被跟踪）。
# ⚠️ 不要写成 `.workbuddy/`（带斜杠只匹配目录，而它现在是符号链接 ⇒ 会漏掉）。
.workbuddy

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# 增量门禁生成的作用域 tsconfig（scripts/verify-changed.mjs）
tsconfig.scoped.json

# tsc --build 的类型检查缓存与声明产物（scripts/gen-tsconfig-refs.mjs）
node_modules/.cache/apollo/
