{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current Vue native remediation workflow",
  "description": "One current work ledger. Previous scans and implementation acceptance remain dated evidence, not scheduling state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "phase",
    "revision",
    "dispatch",
    "legacyEvidence",
    "tasks",
    "finalAcceptance"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "round": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["architecture", "acceptance"] },
    "revision": { "type": "integer", "minimum": 0 },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "maxParallel", "integrator"],
      "properties": {
        "status": { "enum": ["paused", "running"] },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 5 },
        "integrator": { "type": "string", "minLength": 1 }
      }
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "scan",
        "completedBaseline",
        "batch",
        "implementationComponents",
        "implementationFoundation"
      ],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "scan": { "$ref": "#/$defs/Path" },
        "completedBaseline": { "$ref": "#/$defs/Path" },
        "batch": { "$ref": "#/$defs/Path" },
        "implementationComponents": { "$ref": "#/$defs/Path" },
        "implementationFoundation": { "$ref": "#/$defs/Path" }
      }
    },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/Task" } },
    "finalAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceCommit", "gates"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "passed", "failed"] },
        "sourceCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "status", "sourceCommit"],
            "properties": {
              "dimension": {
                "enum": [
                  "api",
                  "tokens",
                  "styles",
                  "unit",
                  "interaction",
                  "types",
                  "a11y",
                  "visual",
                  "docs"
                ]
              },
              "status": { "enum": ["not_started", "in_progress", "passed", "failed", "blocked"] },
              "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "Path": { "type": "string", "minLength": 1 },
    "Paths": { "type": "array", "items": { "$ref": "#/$defs/Path" }, "uniqueItems": true },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "baseRevision", "startedAt"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "baseRevision": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "blocking", "impact", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "fixed", "deferred"] },
        "blocking": { "type": "boolean" },
        "impact": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/Paths" }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ref",
        "title",
        "architectureStatus",
        "acceptanceStatus",
        "workDependencies",
        "owns",
        "assignment",
        "evidence",
        "existingWork",
        "issues"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(CMP|FND|SHARED):[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["component", "foundation", "shared"] },
        "ref": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "architectureStatus": {
          "enum": ["not_started", "partial", "in_progress", "done", "blocked"],
          "description": "Partial retains scoped work; not_started can retain inventory or historical scans without claiming the current implementation task started."
        },
        "acceptanceStatus": {
          "enum": ["not_started", "historical_passed", "passed", "failed"],
          "description": "Historical passed retains its original date and source; passed belongs to the final frozen-version acceptance."
        },
        "workDependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "owns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*[*?\\[\\]\\\\]).+$" },
          "uniqueItems": true
        },
        "assignment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Assignment" }] },
        "evidence": { "$ref": "#/$defs/Paths" },
        "existingWork": { "$ref": "#/$defs/Paths" },
        "historicalAcceptance": {
          "$ref": "#/$defs/Paths",
          "minItems": 1,
          "description": "Dated complete-delivery evidence remains when current acceptance advances to a final frozen-version pass."
        },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "plan": {
          "type": "object",
          "description": "A concise remaining-work assessment, not a completion or verification result. Missing assessments mean unknown effort.",
          "additionalProperties": false,
          "required": ["goal", "remaining", "effort", "basis"],
          "properties": {
            "goal": { "type": "string", "minLength": 1 },
            "remaining": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "effort": { "enum": ["small", "medium", "large", "unknown"] },
            "basis": { "$ref": "#/$defs/Paths", "minItems": 1 },
            "decisions": { "$ref": "#/$defs/Paths" }
          }
        },
        "verification": {
          "type": "object",
          "required": ["scope", "checks", "passed"],
          "properties": {
            "scope": { "type": "array", "items": { "type": "string" } },
            "passed": { "type": "boolean" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "command", "exitCode", "signal"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "command": { "type": "string", "minLength": 1 },
                  "exitCode": { "type": ["integer", "null"] },
                  "signal": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
