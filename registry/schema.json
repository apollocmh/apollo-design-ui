{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apollo-design.dev/schemas/registry.json",
  "title": "Apollo Design Registry",
  "description": "Static Apollo inventory, dependency/token metadata and historical reference facts. Current task state has its own vue-native-audit.schema.json.",
  "definitions": {
    "Priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]
    },
    "Complexity": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"]
    },
    "Group": {
      "type": "string",
      "enum": ["通用", "布局", "导航", "数据录入", "数据展示", "反馈", "其他"]
    },
    "Component": {
      "type": "object",
      "required": ["name", "exportName", "group", "priority", "complexity", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Apollo 组件目录的 kebab-case 名称"
        },
        "exportName": {
          "type": "string",
          "description": "PascalCase 导出名，如 Button"
        },
        "group": {
          "$ref": "#/definitions/Group"
        },
        "priority": {
          "$ref": "#/definitions/Priority"
        },
        "priorityNum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "complexity": {
          "$ref": "#/definitions/Complexity"
        },
        "derived": {
          "type": "object",
          "description": "由 Apollo 清单推导的字段",
          "additionalProperties": false,
          "properties": {
            "dagLevel": {
              "type": ["integer", "null"]
            },
            "unblocks": {
              "type": "integer",
              "description": "完成后能解锁的下游组件数（传递闭包）"
            },
            "tokenCount": {
              "type": "integer"
            },
            "tokenGroup": {
              "type": ["string", "null"]
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "阻塞性依赖：运行时真的 import 了这些组件"
            },
            "typeOnly": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "仅类型引用，不阻塞实现"
            },
            "foundation": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^@apollo-design/"
              },
              "description": "该组件需要的 @apollo-design/* 包"
            }
          }
        },
        "notes": {
          "type": ["string", "null"]
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      },
      "description": "Static inventory facts only. Current task progress lives in registry/vue-native-audit.json."
    },
    "ComponentsFile": {
      "type": "object",
      "required": ["generatedAt", "legend", "summary", "components"],
      "additionalProperties": true,
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "sourceFacts": {
          "type": "string"
        },
        "legend": {
          "type": "object"
        },
        "summary": {
          "type": "object",
          "required": ["total", "byPriority", "byGroup"],
          "additionalProperties": true,
          "properties": {
            "total": {
              "type": "integer"
            },
            "byPriority": {
              "type": "object"
            },
            "byGroup": {
              "type": "object"
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Component"
          },
          "minItems": 1
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "RcReplacement": {
      "type": "object",
      "required": ["pkg", "kind", "capability", "strategy", "target", "rationale", "risk"],
      "additionalProperties": true,
      "properties": {
        "pkg": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["rc", "ecosystem", "transitive"]
        },
        "capability": {
          "type": "string"
        },
        "strategy": {
          "type": "string",
          "enum": ["reuse", "apollo", "in-ui", "drop"]
        },
        "target": {
          "type": "string"
        },
        "foundationPkg": {
          "type": ["string", "null"]
        },
        "rationale": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "usedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usedByCount": {
          "type": "integer"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "FoundationPackage": {
      "type": "object",
      "required": ["name", "layer", "purpose", "replaces", "risk", "readiness"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "测试"]
        },
        "purpose": {
          "type": "string"
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "readiness": {
          "type": "string"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "FoundationDerived": {
      "type": "object",
      "additionalProperties": false,
      "description": "由 foundation-status.mjs 推导，禁止手工编辑",
      "properties": {
        "implOrder": {
          "type": ["integer", "null"],
          "description": "拓扑序（严格尊重 dependsOn）。与 phase2Order 不同：phase2Order 是含 PoC 验证点的推进顺序，implOrder 是「可以开始完整实现」的顺序"
        },
        "componentConsumers": {
          "type": "integer",
          "description": "有多少个组件依赖本包"
        },
        "componentConsumersByPriority": {
          "type": "object"
        },
        "packageConsumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "srcFiles": {
          "type": "integer"
        },
        "srcLines": {
          "type": "integer"
        },
        "exportDeclarations": {
          "type": "integer"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "FoundationEntry": {
      "type": "object",
      "required": [
        "name",
        "dir",
        "layer",
        "risk",
        "purpose",
        "replaces",
        "notDo",
        "readiness",
        "pocRequired",
        "dependsOn",
        "dependedOnBy",
        "derived"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@apollo-design/"
        },
        "dir": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "layer": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "测试"]
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "purpose": {
          "type": "string"
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notDo": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "职责边界。来自 packages/<dir>/README.md 的「明确不做」"
        },
        "readiness": {
          "type": "string",
          "description": "Package design/reference fact. Current work dependencies and blockers are defined only in vue-native-audit.json."
        },
        "pocRequired": {
          "type": "boolean",
          "description": "Package design/reference fact. Current work dependencies and blockers are defined only in vue-native-audit.json."
        },
        "pocNote": {
          "type": ["string", "null"],
          "description": "Package design/reference fact. Current work dependencies and blockers are defined only in vue-native-audit.json."
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "依赖的其他 foundation 包"
        },
        "dependedOnBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "$ref": "#/definitions/FoundationDerived"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      },
      "description": "Static inventory facts only. Current task progress lives in registry/vue-native-audit.json."
    },
    "FoundationFile": {
      "type": "object",
      "required": ["generatedAt", "legend", "summary", "packages"],
      "additionalProperties": true,
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "sourceFacts": {
          "type": "string"
        },
        "legend": {
          "type": "object"
        },
        "summary": {
          "type": "object",
          "required": ["total", "byLayer"],
          "additionalProperties": true,
          "properties": {
            "total": {
              "type": "integer"
            },
            "byLayer": {
              "type": "object"
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FoundationEntry"
          },
          "minItems": 1
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        },
        "historicalFacts": {
          "type": "object",
          "description": "Dated source/analysis facts carried from the archived implementation registry; not a current completion gate."
        },
        "referenceDecisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpenDecision"
          },
          "description": "等待用户裁决的跨切面决策。工具只保留、不生成。"
        }
      }
    },
    "OpenDecision": {
      "type": "object",
      "required": ["id", "question", "impact", "status"],
      "additionalProperties": false,
      "description": "等待用户裁决的跨切面决策。放在注册表里，是因为「项目卡在什么问题上」必须与「项目做到哪了」一样可被机器读取 —— 否则它会散落在对话历史里，每换一个会话就要重新解释一遍。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "question": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "为什么会有这个问题、不决定会怎样"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "tradeoff"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "tradeoff": {
                "type": "string"
              }
            }
          }
        },
        "recommendation": {
          "type": ["string", "null"]
        },
        "impact": {
          "type": "string",
          "description": "阻塞范围的人话描述"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Original decision classification retained as a reference fact. It does not impose current task dependencies or completion gates."
        },
        "hardBlock": {
          "type": "boolean",
          "description": "Original decision classification retained as a reference fact. It does not impose current task dependencies or completion gates."
        },
        "status": {
          "type": "string",
          "enum": ["open", "decided", "deferred"]
        },
        "raisedAt": {
          "type": ["string", "null"]
        },
        "decidedAt": {
          "type": ["string", "null"]
        },
        "decision": {
          "type": ["string", "null"]
        },
        "decidedBy": {
          "type": ["string", "null"],
          "description": "裁决人 / 裁决来源（如「Phase 2 架构设计」）"
        },
        "note": {
          "type": ["string", "null"],
          "description": "人工追加的说明，不参与生成覆盖"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "DependenciesFile": {
      "type": "object",
      "required": [
        "generatedAt",
        "summary",
        "foundationPackages",
        "rcReplacements",
        "componentDag"
      ],
      "additionalProperties": true,
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "summary": {
          "type": "object"
        },
        "strategyLegend": {
          "type": "object"
        },
        "foundationPackages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FoundationPackage"
          }
        },
        "rcReplacements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RcReplacement"
          }
        },
        "ecosystemReuse": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RcReplacement"
          }
        },
        "componentDag": {
          "type": "object",
          "required": ["nodes", "edges", "layers"],
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "object"
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "kind"],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["runtime", "type-only"]
                  }
                }
              }
            },
            "layers": {
              "type": "object"
            }
          }
        },
        "cycleResolutions": {
          "type": "array"
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    },
    "TokensFile": {
      "type": "object",
      "required": ["generatedAt", "cssVar", "summary", "layers", "algorithms"],
      "additionalProperties": true,
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "cssVar": {
          "type": "object",
          "required": ["prefix", "naming", "mode"],
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string"
            },
            "naming": {
              "type": "string"
            },
            "example": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": ["zero-runtime"]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "summary": {
          "type": "object"
        },
        "layers": {
          "type": "object"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "referenceEvidence": {
          "type": "object",
          "description": "带来源版本的历史证据；不参与完成条件"
        }
      }
    }
  }
}
