{
  "name": "@apollo-design/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 native reimplementation of Ant Design. Ant Design React is treated as a compatibility specification, never as source to be translated.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "antd:extract": "node registry/tools/extract-antd-facts.mjs --download",
    "antd:extract:local": "node registry/tools/extract-antd-facts.mjs --artifact",
    "scaffold": "node registry/tools/scaffold-packages.mjs",
    "gen:component": "node registry/tools/gen-component.mjs",
    "registry:gen": "node registry/tools/gen-registry.mjs",
    "registry:validate": "node registry/tools/validate-registry.mjs",
    "registry:next": "node registry/tools/next-task.mjs",
    "registry:foundation": "node registry/tools/foundation-status.mjs",
    "registry:foundation:check": "node registry/tools/foundation-status.mjs --check",
    "registry:foundation:verify": "node registry/tools/foundation-status.mjs --verify",
    "registry:workstreams": "node registry/tools/gen-workstreams.mjs",
    "registry:workstreams:check": "node registry/tools/gen-workstreams.mjs --check",
    "registry:dag": "node registry/tools/gen-registry.mjs --print-dag",
    "registry:next:parallel": "node registry/tools/next-task.mjs --parallel",
    "registry:check": "pnpm run registry:gen && pnpm run registry:foundation:check && pnpm run registry:workstreams:check && pnpm run registry:validate",
    "lint": "pnpm run lint:types && pnpm run lint:format",
    "lint:types": "vue-tsc --noEmit -p tsconfig.json",
    "lint:format": "biome check .",
    "test": "pnpm run test:unit && pnpm run test:dom && pnpm run test:a11y && pnpm run test:theme",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom-contract",
    "test:a11y": "vitest run --project a11y --passWithNoTests",
    "test:theme": "vitest run --project theme --passWithNoTests",
    "test:types": "vitest run --project types",
    "test:coverage": "vitest run --coverage --maxWorkers=2 --project unit --project dom-contract --project a11y --project theme",
    "test:visual:check": "node tests/visual/run.mjs --check-baselines",
    "test:visual": "node tests/visual/run.mjs",
    "test:compat": "node tests/compat/runner/index.mjs",
    "test:compat:baseline": "node tests/compat/runner/index.mjs --baseline",
    "test:build": "node tests/build/run.mjs",
    "build": "pnpm -r --filter './packages/**' run build",
    "build:ui": "pnpm --filter @apollo-design/ui run build",
    "dev": "pnpm --filter @apollo-design/docs run dev",
    "verify:changed": "node scripts/verify-changed.mjs",
    "verify:component": "node scripts/verify-component.mjs",
    "verify:full": "pnpm run registry:check && pnpm run lint && pnpm run test && pnpm run test:build",
    "typecheck:build": "node scripts/gen-tsconfig-refs.mjs && vue-tsc --build tsconfig.check.json",
    "typecheck:refs": "node scripts/gen-tsconfig-refs.mjs",
    "ask": "node registry/tools/ask.mjs"
  },
  "devDependencies": {
    "@apollo-design/theme": "workspace:*",
    "@apollo-design/ui": "workspace:*",
    "@ant-design/icons": "catalog:",
    "@biomejs/biome": "catalog:",
    "@rc-component/picker": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "antd": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
