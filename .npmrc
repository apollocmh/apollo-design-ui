# Strict isolation: a package may only import what it declares in its own package.json.
# This is what makes the dependency DAG enforceable rather than aspirational.
hoist=false
strict-peer-dependencies=true
auto-install-peers=false
save-exact=false

# Keep workspace linking deterministic.
link-workspace-packages=true
prefer-workspace-packages=true

# Lockfile hygiene.
resolution-mode=highest
