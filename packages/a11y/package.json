{
  "name": "@apollo-design/a11y",
  "version": "0.0.0",
  "description": "运行时无障碍原语。antd 把焦点管理、roving tabindex、live region 等散落在各组件与 rc 包里，本项目把它们收敛为可复用的原语。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild --config ../../scripts/unbuild-preserve-modules.mjs",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@apollo-design/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@apollo-design/test-utils": "workspace:*"
  }
}
