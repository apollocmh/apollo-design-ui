{
  "name": "@apollo-design/theme",
  "version": "0.1.9",
  "description": "Apollo Design tokens, theme presets, CSS variables and Vue theme context.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./presets/default": {
      "types": "./dist/presets/default.d.ts",
      "import": "./dist/presets/default.mjs"
    },
    "./presets/mono": {
      "types": "./dist/presets/mono.d.ts",
      "import": "./dist/presets/mono.mjs"
    },
    "./presets/material3": {
      "types": "./dist/presets/material3.d.ts",
      "import": "./dist/presets/material3.mjs"
    },
    "./presets/default.css": "./dist/presets/default.css",
    "./presets/mono.css": "./dist/presets/mono.css",
    "./presets/material3.css": "./dist/presets/material3.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@apollo-design/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@apollo-design/test-utils": "workspace:*",
    "@ant-design/colors": "catalog:",
    "@ant-design/fast-color": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apollocmh/apollo-design-ui.git",
    "directory": "packages/theme"
  },
  "homepage": "https://apollocmh.github.io/apollo-design-ui/",
  "bugs": {
    "url": "https://github.com/apollocmh/apollo-design-ui/issues"
  }
}
