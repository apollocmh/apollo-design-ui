{
  "name": "@apollo-design/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Apollo Design 官网（Vue 3 + Vite + vite-ssg 独立产品应用，弃用 VitePress）。",
  "type": "module",
  "scripts": {
    "dev": "node tooling/content/build-manifest.mjs && vite",
    "build": "node tooling/content/build-manifest.mjs && vite-ssg build",
    "preview": "vite preview",
    "content:check": "node tooling/content/build-manifest.mjs --check",
    "content:build": "node tooling/content/build-manifest.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node tooling/content/build-manifest.mjs --if-missing && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@apollo-design/icons": "workspace:*",
    "@apollo-design/locale": "workspace:*",
    "@apollo-design/theme": "workspace:*",
    "@apollo-design/ui": "workspace:*",
    "@unhead/vue": "^2.1.17",
    "dayjs": "catalog:",
    "vue": "catalog:",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "jsdom": "catalog:",
    "markdown-it": "^14.1.0",
    "shiki": "^3.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-ssg": "28.3.0",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "yaml": "^2.8.0"
  }
}
