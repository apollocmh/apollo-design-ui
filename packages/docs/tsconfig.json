{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@apollo-design/ui": ["../ui/src/index.ts"],
      "@apollo-design/icons": ["../icons/src/index.ts"],
      "@apollo-design/theme": ["../theme/src/index.ts"],
      "@apollo-design/locale": ["../locale/src/index.ts"],
      "@apollo-design/utils": ["../utils/src/index.ts"],
      "@apollo-design/motion": ["../motion/src/index.ts"],
      "@apollo-design/portal": ["../portal/src/index.ts"],
      "@apollo-design/position": ["../position/src/index.ts"],
      "@apollo-design/a11y": ["../a11y/src/index.ts"],
      "@apollo-design/virtual-list": ["../virtual-list/src/index.ts"],
      "@apollo-design/overlay": ["../overlay/src/index.ts"],
      "@apollo-design/form-core": ["../form-core/src/index.ts"],
      "@apollo-design/picker": ["../picker/src/index.ts"],
      "@apollo-design/test-utils": ["../test-utils/src/index.ts"],
      "@": ["./src"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tooling/**/*.mjs",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".generated", ".vite-ssg-temp"]
}
