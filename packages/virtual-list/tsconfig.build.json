{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "../..",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "types": ["node", "vite/client"],
    "paths": {
      "@apollo-design/utils": ["../utils/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts",
    "**/demo/**",
    "dist",
    "node_modules"
  ]
}
