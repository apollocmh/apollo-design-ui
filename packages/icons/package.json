{
  "name": "@apollo-design/icons",
  "version": "0.0.0",
  "description": "Vue 图标组件集。以 @ant-design/icons-svg 为数据源生成，保证与 antd 图标像素一致。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons-svg": "catalog:",
    "@ant-design/colors": "catalog:",
    "@apollo-design/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@apollo-design/test-utils": "workspace:*"
  }
}
