{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@apollo-design/utils": ["../utils/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-d.ts", "dist", "node_modules"]
}
