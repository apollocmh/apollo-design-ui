{
  "name": "@apollo-design/test-utils",
  "version": "0.1.9",
  "description": "Private Vue component testing helpers for Apollo Design.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild --config ../../scripts/unbuild-preserve-modules.mjs",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@apollo-design/theme": "workspace:*",
    "@apollo-design/utils": "workspace:*",
    "@vue/test-utils": "catalog:",
    "axe-core": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
